{
  "format": "control-explorer-example",
  "version": 1,
  "parameters": "K_R = 2.0\nT_t = np.pi / 4\n\n# Beispiele:\n# T1 = 1.0\n# Kp = 1.5",
  "system": "K_R / (s**3 + 3*s**2 + 3*s + 1)",
