    "t_max": "20",
    "t_points": "2000",
    "pade_order": "6",
    "marker_omega": "0, 1",
    "plot_system": "Offener Kreis G_0(s)",
    "auto_update": true,
    "grid": true,
    "equal_axis": true,
    "show_negative_freq": false,
    "show_critical_point": true,
    "normalized_nyquist": false,
    "direction_arrow_omegas": "0.5, 2, 5 "
